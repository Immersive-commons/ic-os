<?xml version="1.0" encoding="utf-8"?>
<!-- IC sensor bus: a persistent, platform-signed system app that holds raw sensors and
     serves consent-gated streams to companion apps. See docs/SENSOR_BUS.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.immersivecommons.sensorbus"
    android:versionCode="2"
    android:versionName="0.2">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <!-- Only the bus (platform signature) may bind a companion's keepalive host service. -->
    <permission
        android:name="org.immersivecommons.permission.BIND_COMPANION"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.immersivecommons.permission.BIND_COMPANION" />

    <!-- normal on stock Android (see docs/PATCHES.md #1); the bus serves up to 100+ Hz -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- resolve and bind any companion's host service -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".BusApplication"
        android:label="IC Sensor Bus"
        android:persistent="true"
        android:directBootAware="true">
        <service
            android:name=".SensorBusService"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="org.immersivecommons.sensorbus.BIND" />
            </intent-filter>
        </service>
        <provider
            android:name=".ControlProvider"
            android:authorities="org.immersivecommons.sensorbus.control"
            android:exported="true"
            android:directBootAware="true" />
    </application>
</manifest>
