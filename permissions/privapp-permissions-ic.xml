<?xml version="1.0" encoding="utf-8"?>
<!-- Allowlist for the IC sensor bus as a /system_ext/priv-app. A userdebug build with
     enforced privapp permissions refuses to boot if a priv-app requests a privileged
     permission missing from here. The v0 bus requests none (the probe's ones are gone),
     but the file stays so the next privileged permission has an obvious home. -->
<permissions>
    <privapp-permissions package="org.immersivecommons.sensorbus">
    </privapp-permissions>
</permissions>
